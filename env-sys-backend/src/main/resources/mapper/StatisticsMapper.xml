<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.backend.envsysbackend.mapper.StatisticsMapper">

    <resultMap id="BaseResultMap"
               type="com.backend.envsysbackend.entity.Statistics">

        <id column="id" property="id"/>

        <result column="province_id" property="provinceId"/>
        <result column="city_id" property="cityId"/>
        <result column="address" property="address"/>

        <result column="so2_value" property="so2Value"/>
        <result column="so2_level" property="so2Level"/>

        <result column="co_value" property="coValue"/>
        <result column="co_level" property="coLevel"/>

        <result column="spm_value" property="spmValue"/>
        <result column="spm_level" property="spmLevel"/>

        <result column="aqi_id" property="aqiId"/>

        <result column="confirm_date" property="confirmDate"/>
        <result column="confirm_time" property="confirmTime"/>

        <result column="gm_id" property="gmId"/>
        <result column="fd_id" property="fdId"/>

        <result column="information" property="information"/>
        <result column="remarks" property="remarks"/>

        <result column="province_name" property="provinceName"/>
        <result column="city_name" property="cityName"/>
        <result column="real_name" property="realName"/>
        <result column="gm_name" property="gmName"/>
        <result column="tel" property="gmTel"/>

    </resultMap>

    <sql id="BASIC_SQL">
        SELECT
            st.*,
            gp.province_name,
            gc.city_name,
            s.real_name,
            gm.*
        FROM statistics st

                 LEFT JOIN grid_province gp
                           ON st.province_id = gp.province_id

                 LEFT JOIN grid_city gc
                           ON st.city_id = gc.city_id

                 LEFT JOIN supervisor s
                           ON st.fd_id = s.tel_id

                 LEFT JOIN grid_member gm
                           ON st.gm_id = gm.gm_id
    </sql>

    <select id="selectList" resultMap="BaseResultMap">
        <include refid="BASIC_SQL"/>
        ${ew.customSqlSegment}
    </select>

    <select id="selectOne" resultMap="BaseResultMap">
        <include refid="BASIC_SQL"/>
        ${ew.customSqlSegment}
    </select>

    <select id="selectPage" resultMap="BaseResultMap">
        <include refid="BASIC_SQL"/>
        ${ew.customSqlSegment}
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        <include refid="BASIC_SQL"/>
        WHERE st.id = #{id}
    </select>

</mapper>